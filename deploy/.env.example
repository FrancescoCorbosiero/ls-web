# Copy to deploy/.env on the server (chmod 600) and fill the values. Never commit the copy.
# Every variable the app, compose.yml and backup.sh read; the ones marked (required) have no default.
# Generate keys with:  openssl rand -base64 32
#
# Format rules (the file is read by Docker Compose and sourced by bash in backup.sh):
#   * comments only on their own line: "KEY=   # text" would make the comment the value;
#   * a value with spaces goes in double quotes.

# ---- image and profile ---------------------------------------------------------------------
# Tag of the public image ghcr.io/francescocorbosiero/ls-web (no login needed): latest = main;
# a sha-… tag pins a version (rollback, runbook §3).
LS_IMAGE_TAG=latest
# prod | staging (staging keeps the directory mail sink unless an allow-list is set)
SPRING_PROFILES_ACTIVE=prod

# ---- proxy (Caddy behind Cloudflare: no certificate settings) --------------------------------
# Apex domain; www., app., ordini., dashboard. are derived.
LS_DOMAIN=logisticasanchez.com

# ---- database (the db service and the app's DATABASE_* settings) -----------------------------
POSTGRES_DB=ls_web
POSTGRES_USER=ls
# (required) also used as DATABASE_PASSWORD
POSTGRES_PASSWORD=
# ls.db-pool-size: Hikari maximum pool size
LS_DB_POOL_SIZE=10

# ---- security (required in staging and prod: the app refuses to start without them) ----------
# (required) ls.security.ip-hash-key: HMAC key of the IP hashes in lead/audit rows
LS_SECURITY_IP_HASH_KEY=
# (required) ls.notifications.token-encryption-key: base64 AES key of the queued one-time tokens
LS_TOKEN_ENCRYPTION_KEY=

# ---- e-mail (ls.notifications.*) -------------------------------------------------------------
# ses | directory | memory (prod requires ses)
LS_NOTIFICATIONS_SINK=ses
# Staging only: comma-separated recipients that may receive e-mail; everyone else is dropped.
LS_NOTIFICATIONS_ALLOW_LIST=
# Verified SES identity (ADR 0015).
LS_NOTIFICATIONS_FROMADDRESS=noreply@logisticasanchez.com
LS_NOTIFICATIONS_SES_REGION=eu-north-1
# (required in prod) IAM user limited to ses:SendEmail / ses:SendRawEmail (chapter 10 §4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- business configuration (ls.business.*, ADR 0027; defaults are the real contacts) --------
# Office mailbox that receives EML-06/07/08 (Q-43). Leave the line commented for the default of
# BusinessProperties: an empty value stops the app at start-up.
# LS_BUSINESS_OFFICEEMAIL=ufficio@example.com
# Absolute base of every link in e-mails and config.js.
LS_BUSINESS_SITEURL=https://logisticasanchez.com
# LS_BUSINESS_PHONE="+39 329 239 6962"
# LS_BUSINESS_WHATSAPP=393292396962
# LS_BUSINESS_HOURS_WEEKDAYS="8:00–18:00"
# LS_BUSINESS_HOURS_SATURDAY="8:00–12:00"

# ---- backups (deploy/backup.sh reads this file; runbook §4) ---------------------------------
# Optional: an age public key (age1…) encrypts the backups; required only for an off-site copy.
# LS_BACKUP_AGE_RECIPIENT=age1...
# LS_BACKUP_DIR=/var/backups/ls-web
# Off-site copy with rclone, when set:
# LS_BACKUP_RCLONE_REMOTE=offsite:ls-web-backups
# backup.sh --check threshold:
# LS_BACKUP_MAX_AGE_HOURS=26

# ---- optional settings read by the app (defaults in it.logisticasanchez.web.platform.config) --
# Uncomment to change a default; every line of this file reaches the app (compose.yml env_file).
# SERVER_PORT=8080
# Fixed to true by the staging/prod profiles:
# LS_SECURITY_PROXY_TRUSTFORWARDEDHEADERS=true
# Prod profile default:
# LS_SECURITY_HSTS_ENABLED=true
# PD-10:
# LS_SECURITY_STAFF_LOCKOUT_THRESHOLD=10
# LS_SECURITY_STAFF_LOCKOUT_DURATION=15m
# LS_SECURITY_SESSIONS_STAFF_IDLE=30m
# LS_SECURITY_SESSIONS_STAFF_ABSOLUTE=10h
# LS_SECURITY_SESSIONS_CUSTOMER_IDLE=60m
# LS_SECURITY_SESSIONS_CUSTOMER_ABSOLUTE=12h
# «Resta connesso» after a sign-in link (ADR 0031); 0 = off:
# LS_SECURITY_SESSIONS_CUSTOMER_REMEMBER=60d
# LS_SECURITY_TOKENS_SIGNIN=15m
# LS_SECURITY_TOKENS_REGISTRATION=24h
# Q-07:
# LS_NOTIFICATIONS_CUSTOMERCONFIRMATIONS_ENABLED=true
# LS_NOTIFICATIONS_WORKER_INTERVAL=10s
# LS_NOTIFICATIONS_WORKER_MAXATTEMPTS=8
# Rate limits (TRK-04; forms per 10 minutes; sign-in links per 15 minutes per address):
# LS_RATELIMIT_TRACKINGLOOKUP_PERMITS=60
# LS_RATELIMIT_FORMSUBMIT_PERMITS=10
# LS_RATELIMIT_SIGNINLINKEMAIL_PERMITS=5
# Hosts (with LS_SITE_HOSTS_WWW / _APP / _ORDERS / _DASHBOARD):
# LS_SITE_HOSTS_CANONICAL=logisticasanchez.com
# Q-30 and Q-39:
# LS_COMPAT_HOSTS=logisticasanchez.com,app.logisticasanchez.com
# LS_COMPAT_CORS_ALLOWEDORIGINS=https://logisticasanchez.com
# Retention jobs (ADR 0024):
# LS_RETENTION_ENABLED=true
# LS_FLAGS_OVERRIDE_* is refused in prod (ADR 0025).
