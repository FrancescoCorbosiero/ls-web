# Copy to deploy/.env on the server (chmod 600) and fill the values. Never commit the copy.
# Every variable the app and compose.yml read; the ones marked (required) have no default.
# Generate keys with:  openssl rand -base64 32

# ---- image and profile ---------------------------------------------------------------------
LS_IMAGE_TAG=latest                      # tag of ghcr.io/francescocorbosiero/ls-web (CI pushes sha-… and branch tags)
SPRING_PROFILES_ACTIVE=prod              # prod | staging (staging keeps the directory mail sink unless an allow-list is set)

# ---- proxy (Caddy) ---------------------------------------------------------------------------
LS_DOMAIN=logisticasanchez.com           # apex; www., app., ordini., dashboard. are derived
LS_ACME_EMAIL=                           # (required) e-mail Let's Encrypt writes to about certificates

# ---- database (the db service and the app's DATABASE_* settings) -----------------------------
POSTGRES_DB=ls_web
POSTGRES_USER=ls
POSTGRES_PASSWORD=                       # (required) also used as DATABASE_PASSWORD
LS_DB_POOL_SIZE=10                       # ls.db-pool-size: Hikari maximum pool size

# ---- security (required in staging and prod: the app refuses to start without them) ----------
LS_SECURITY_IP_HASH_KEY=                 # ls.security.ip-hash-key: HMAC key of the IP hashes in lead/audit rows
LS_TOKEN_ENCRYPTION_KEY=                 # ls.notifications.token-encryption-key: base64 AES key of the queued one-time tokens

# ---- e-mail (ls.notifications.*) -------------------------------------------------------------
LS_NOTIFICATIONS_SINK=ses                # ses | directory | memory (prod requires ses)
LS_NOTIFICATIONS_ALLOW_LIST=             # staging only: comma-separated recipients that may receive e-mail; everyone else is dropped
LS_NOTIFICATIONS_FROMADDRESS=noreply@logisticasanchez.com   # verified SES identity (ADR 0015)
LS_NOTIFICATIONS_SES_REGION=eu-north-1
AWS_ACCESS_KEY_ID=                       # IAM user limited to ses:SendEmail / ses:SendRawEmail (chapter 10 §4)
AWS_SECRET_ACCESS_KEY=

# ---- business configuration (ls.business.*, ADR 0027; defaults are the real contacts) --------
LS_BUSINESS_OFFICEEMAIL=                 # office mailbox that receives EML-06/07/08 (Q-43); empty = default
LS_BUSINESS_SITEURL=https://logisticasanchez.com   # absolute base of every link in e-mails and config.js
# LS_BUSINESS_PHONE=+39 329 239 6962
# LS_BUSINESS_WHATSAPP=393292396962
# LS_BUSINESS_HOURS_WEEKDAYS=8:00–18:00
# LS_BUSINESS_HOURS_SATURDAY=8:00–12:00

# ---- optional settings read by the app (defaults in it.logisticasanchez.web.platform.config) --
# SERVER_PORT=8080                                   # inside the container; Caddy proxies to it
# LS_SECURITY_PROXY_TRUSTFORWARDEDHEADERS=true       # fixed to true by the staging/prod profiles
# LS_SECURITY_HSTS_ENABLED=true                      # prod profile default
# LS_SECURITY_STAFF_LOCKOUT_THRESHOLD=10             # PD-10
# LS_SECURITY_STAFF_LOCKOUT_DURATION=15m
# LS_SECURITY_SESSIONS_STAFF_IDLE=30m
# LS_SECURITY_SESSIONS_STAFF_ABSOLUTE=10h
# LS_SECURITY_SESSIONS_CUSTOMER_IDLE=60m
# LS_SECURITY_SESSIONS_CUSTOMER_ABSOLUTE=12h
# LS_SECURITY_TOKENS_SIGNIN=15m
# LS_SECURITY_TOKENS_REGISTRATION=24h
# LS_NOTIFICATIONS_CUSTOMERCONFIRMATIONS_ENABLED=true   # Q-07
# LS_NOTIFICATIONS_WORKER_INTERVAL=10s
# LS_NOTIFICATIONS_WORKER_MAXATTEMPTS=8
# LS_NOTIFICATIONS_DIRECTORY_PATH=.local/mail        # directory sink only
# LS_RATELIMIT_TRACKINGLOOKUP_PERMITS=60             # per minute per IP (TRK-04)
# LS_RATELIMIT_FORMSUBMIT_PERMITS=10                 # per 10 minutes per IP
# LS_RATELIMIT_SIGNINLINKEMAIL_PERMITS=5             # per 15 minutes per address
# LS_SITE_HOSTS_CANONICAL=logisticasanchez.com       # with LS_SITE_HOSTS_WWW / _APP / _ORDERS / _DASHBOARD
# LS_COMPAT_HOSTS=logisticasanchez.com,app.logisticasanchez.com   # Q-30
# LS_COMPAT_CORS_ALLOWEDORIGINS=https://logisticasanchez.com      # Q-39
# LS_RETENTION_ENABLED=true                          # retention jobs (ADR 0024)
# LS_FLAGS_OVERRIDE_*                                # refused in prod (ADR 0025)
