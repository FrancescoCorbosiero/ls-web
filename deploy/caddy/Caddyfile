# Caddy 2 in front of the app, behind Cloudflare (proxied records, SSL/TLS mode «Full»; the server's
# firewall lets in only Cloudflare). Cloudflare holds the public certificates; the hop Cloudflare ->
# Caddy is encrypted with Caddy's own internal certificate (tls internal), so no ACME e-mail, no
# certificate to copy and nothing to renew by hand.
# Host-based behaviour (www -> apex, ordini. -> /area-clienti/, dashboard. -> /gestione/, app. served
# as the apex for the kept /mono/api paths) is decided by the app (HostRoutingFilter), so every
# host is proxied the same way.
# The client IP: Caddy trusts Cloudflare's ranges (https://www.cloudflare.com/ips/), reads the
# visitor's address from CF-Connecting-IP and sends it to the app as the only X-Forwarded-For value,
# which the app trusts for one hop (ls.security.proxy.trust-forwarded-headers=true): rate limits and
# IP hashes see the visitor, not a Cloudflare edge.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$LS_DOMAIN:logisticasanchez.com},
www.{$LS_DOMAIN:logisticasanchez.com},
app.{$LS_DOMAIN:logisticasanchez.com},
ordini.{$LS_DOMAIN:logisticasanchez.com},
dashboard.{$LS_DOMAIN:logisticasanchez.com} {
	tls internal
	encode zstd gzip
	header -Server
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Host {host}
		health_uri /actuator/health
		health_interval 30s
	}
	log {
		output stdout
		format json
	}
}
